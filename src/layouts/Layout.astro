---
import { siteConfig, profileConfig } from '@/config';
import { url } from '@utils/url-utils';
import ThemeIcon from '@components/control/ThemeIcon.astro';
import SiteNavi from '@components/control/SiteNavi.astro';
import Footer from '@components/Footer.astro';
import { ClientRouter } from "astro:transitions";

const pageTitle = `${siteConfig.title} - ${siteConfig.subTitle}`;
const backgroundImageEnabled = siteConfig.backgroundImage.enabled;
const backgroundImageUrl = url(siteConfig.backgroundImage.url);


---
<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark" class="dark">
<head>
    <script is:inline>
        (function() {
        const savedTheme = localStorage.getItem('theme');
        const theme = (savedTheme === 'light' || savedTheme === 'dark')
          ? savedTheme
          : 'dark';
        localStorage.setItem('theme', theme);
        document.documentElement.setAttribute('data-theme', theme);

        if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.style.colorScheme = 'dark';
        } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.style.colorScheme = 'light';
        }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={`${profileConfig.description}. This is a ${profileConfig.name} site, which is built with Astro.`}>
    <meta name="author" content={profileConfig.name}>
    <meta name="theme-color" content="#1e1e1e">
    <link rel="icon" href={url(siteConfig.favicon)} type="image/jpeg" sizes="any">
    <link rel="shortcut icon" href={url(siteConfig.favicon)} type="image/jpeg">
    <link rel="apple-touch-icon" href={url(profileConfig.avatar)}>
    <title>{pageTitle}</title>
    <ClientRouter />
</head>
<body class="layout-body">
    <a class="skip-link" href="#main">跳到内容</a>
    <div class="matrix" aria-hidden="true">
        <div class="matrix-mesh"></div>
    </div>
    { siteConfig.mirrorSite?.enabled && <SiteNavi /> }
    <ThemeIcon />
    <main id="main" class="main-content" tabindex="-1">
        <slot />
    </main>
    <Footer />
</body>

</html>


<style is:global define:vars={{}}>
@font-face {
  font-family: 'Comic Sans MS';
  src: url('/fonts/ComicSansMS.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

:root {
    --matrix-field: #F4F5F7;
    --grid-size: 20px;
    --grid-dot-color: #c7c7c780;
    --text-color: #1A2422;
    --footer-text-color: #5A6B66;
    --link-color: #2F5E54;
    --motto-text-color: #6A7A75;
    --border-color: #B7C4BF;
    --image-shadow-color: rgba(44, 74, 67, 0.18);
    --bg-color: var(--matrix-field);
    --color-background-primary: var(--matrix-field);
    --color-text: var(--text-color);
}

[data-theme="dark"] {
    --matrix-field: #1e1e1e;
    --grid-dot-color: #c7c7c71f;
    --text-color: #E6EEEC;
    --footer-text-color: #8A9B96;
    --link-color: #A3C4B8;
    --motto-text-color: #9AADA6;
    --border-color: #3D4F49;
    --image-shadow-color: rgba(0, 0, 0, 0.35);
    --bg-color: var(--matrix-field);
    --color-background-primary: var(--matrix-field);
    --color-text: var(--text-color);
}

html {
    min-height: 100%;
    color-scheme: dark;
    background-color: var(--matrix-field);
}

[data-theme="dark"] {
    color-scheme: dark;
}

html, body {
    margin: 0;
    padding: 0;
}

.layout-body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    margin: 0;
    overflow-x: hidden;
}

.main-content {
    flex: 1;
    min-width: 0;
}

body {
    font-family: 'Comic Sans MS', 'Comic Neue', sans-serif;
    background-color: var(--matrix-field);
    color: var(--text-color);
    position: relative;
    min-height: 100dvh;
    max-width: 100%;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
    transition: background-color 0.45s ease, color 0.45s ease;
}

.skip-link {
    position: absolute;
    left: 12px;
    top: 12px;
    z-index: 2000;
    width: max-content;
    max-width: calc(100vw - 24px);
    padding: 8px 12px;
    background: var(--matrix-field);
    color: var(--text-color);
    text-decoration: none;
    transform: translateY(-200%);
}

.skip-link:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--link-color);
    outline-offset: 2px;
}

/* Obsidian 风格网状点阵 + 四周渐变蒙版
   参考：https://forum-zh.obsidian.md/t/topic/42053 */
.matrix {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
}

.matrix-mesh {
    position: absolute;
    inset: 0;
    background-color: var(--matrix-field);
    background-image: radial-gradient(
        circle,
        var(--grid-dot-color) 1px,
        transparent 1px
    );
    background-size: var(--grid-size) var(--grid-size);
    background-position: center center;
    /* 四周渐变蒙版：边缘淡出 */
    -webkit-mask-image:
        linear-gradient(to bottom, transparent, #fff 80px calc(100% - 80px), transparent),
        linear-gradient(to right, transparent, #fff 80px calc(100% - 80px), transparent);
    mask-image:
        linear-gradient(to bottom, transparent, #fff 80px calc(100% - 80px), transparent),
        linear-gradient(to right, transparent, #fff 80px calc(100% - 80px), transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    transition: background-color 0.45s ease;
}

@media (max-width: 640px) {
    .matrix-mesh {
        --grid-size: 18px;
        -webkit-mask-image:
            linear-gradient(to bottom, transparent, #fff 48px calc(100% - 48px), transparent),
            linear-gradient(to right, transparent, #fff 32px calc(100% - 32px), transparent);
        mask-image:
            linear-gradient(to bottom, transparent, #fff 48px calc(100% - 48px), transparent),
            linear-gradient(to right, transparent, #fff 32px calc(100% - 32px), transparent);
    }
}

@media (prefers-reduced-motion: reduce) {
    body,
    .matrix-mesh {
        transition: none;
    }
}

.layout-body > :not(.matrix) {
    position: relative;
    z-index: 1;
}
</style>
